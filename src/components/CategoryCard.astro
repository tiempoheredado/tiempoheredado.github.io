---
export interface Props {
  title: string;
  description: string;
  linkHref: string;
  linkLabel: string;
  offset?: boolean;
  imageSrc?: string;
}

const { title, description, linkHref, linkLabel, offset, imageSrc = 'https://placehold.co/1920x1080' } = Astro.props;
---

<div
  class={`group cursor-pointer relative overflow-hidden flex flex-col rounded-2xl${offset ? ' md:translate-y-8' : ''}`}
>
  <div class="aspect-4/5 overflow-hidden bg-secondary mb-4 relative rounded-2xl">
    <img
      class="w-full h-full object-cover transition-transform duration-700 ease-out group-hover:scale-[1.02]"
      src={imageSrc}
      alt=""
    />
    <div class="absolute inset-0 bg-primary/10 opacity-0 transition-opacity duration-500 group-hover:opacity-100">
    </div>
  </div>
  <div class="pt-4">
    <h2 class="font-headline text-headline-md text-dark mb-1 m-0">
      {title}
    </h2>
    <p class="font-body text-base text-dark mb-4 m-0 pb-4">
      {description}
    </p>
    <a
      href={linkHref}
      class="font-body text-xs text-primary flex items-center gap-1 group-hover:gap-2 transition-all no-underline"
    >
      {linkLabel}
      <span class="material-symbols-outlined">arrow_forward</span>
    </a>
  </div>
</div>
