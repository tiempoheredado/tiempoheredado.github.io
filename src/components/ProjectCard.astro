---
import type { ImageMetadata } from "astro";
import { Image } from "astro:assets";

export interface Props {
  slug: string;
  number: string;
  title: string;
  image: ImageMetadata;
  base?: string;
  variant?: "large" | "small";
}

const { slug, number, title, image, base = "/proyecto", variant = "small" } =
  Astro.props;
---

<a
  href={`${base}/${slug}`}
  class={`group relative overflow-hidden rounded-2xl block ${variant === "large" ? "md:w-[calc(66.667%-0.5rem)] h-64 md:h-[300px]" : "md:w-[calc(33.333%-0.667rem)] h-64 md:h-[300px]"}`}
>
  <Image
    class="w-full h-full object-cover transition-transform duration-700 group-hover:scale-105"
    src={image}
    alt={title}
  />
  <div
    class="absolute inset-0 bg-linear-to-t from-dark/70 via-dark/20 to-transparent bg-dark/20"
  >
  </div>
  <div class="absolute inset-0 flex flex-col justify-end p-6 md:p-8">
    <span
      class="font-body text-xs text-secondary uppercase mb-1"
    >
      {number}
    </span>
    <h3 class="font-headline text-headline-md text-secondary m-0 mb-2">
      {title}
    </h3>
    <span
      class="inline-flex items-center gap-1 font-body text-xs text-secondary uppercase border border-secondary/50 px-4 py-2 rounded-full w-fit opacity-0 group-hover:opacity-100 transition-opacity duration-300"
    >
      Ver Proyecto
      <span class="material-symbols-outlined text-sm">arrow_forward</span>
    </span>
  </div>
</a>
