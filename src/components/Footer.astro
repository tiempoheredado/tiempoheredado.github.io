---
import { CONTENT } from "../utils/content";
---

<footer class="mx-4 mb-4 font-semibold">
  <div class="bg-secondary flex justify-between px-6 md:px-12 py-3 mx-auto">
    <div class="flex gap-2 items-center m-auto">
      {
        CONTENT.footer.links.map((social) =>
          social.href ? (
            <a
              href={social.href}
              aria-label={social.label}
              title={social.label}
class="inline-flex items-center justify-center w-11 h-11 rounded-full text-dark hover:text-primary hover:bg-light/10 transition-all"
            >
              <svg
                viewBox="0 0 448 512"
                fill="currentColor"
                class="w-5 h-5"
                aria-hidden="true"
              >
                <path d="M100.28 448H7.4V148.9h92.88zM53.79 108.1C24.09 108.1 0 83.5 0 53.8a53.79 53.79 0 0 1 107.58 0c0 29.7-24.1 54.3-53.79 54.3zM447.9 448h-92.68V302.4c0-34.7-.7-79.2-48.29-79.2-48.29 0-55.69 37.7-55.69 76.7V448h-92.78V148.9h89.08v40.8h1.3c12.4-23.5 42.69-48.3 87.88-48.3 94 0 111.28 61.9 111.28 142.3V448z" />
              </svg>
            </a>
          ) : (
            <button
              type="button"
              data-email-copy={social.label}
              class="group inline-flex items-center gap-2 cursor-pointer px-3 py-1.5 rounded-full font-body text-base text-dark hover:text-primary hover:bg-light/10 transition-all"
            >
              <span
                data-email-icon
                class="material-symbols-outlined text-base"
                aria-hidden="true"
                >mail</span
              >
              <span data-email-label>{social.label}</span>
              <span
                data-email-feedback
                class="hidden items-center gap-1"
                role="status"
              >
                <span
                  class="material-symbols-outlined text-base"
                  aria-hidden="true"
                  >check</span
                >
                Copiado
              </span>
            </button>
          ),
        )
      }
    </div>
  </div>
</footer>

<script>
  const buttons = document.querySelectorAll("[data-email-copy]");
  const feedbackTimeouts = new Map();

  buttons.forEach((button) => {
    button.addEventListener("click", async () => {
      const email = button.dataset.emailCopy;
      if (!email) return;

      try {
        await navigator.clipboard.writeText(email);
      } catch {
        const textarea = document.createElement("textarea");
        textarea.value = email;
        textarea.style.position = "fixed";
        textarea.style.opacity = "0";
        document.body.appendChild(textarea);
        textarea.select();
        document.execCommand("copy");
        textarea.remove();
      }

      const label = button.querySelector("[data-email-label]");
      const icon = button.querySelector("[data-email-icon]");
      const feedback = button.querySelector("[data-email-feedback]");
      label?.classList.add("hidden");
      icon?.classList.add("hidden");
      feedback?.classList.remove("hidden");
      feedback?.classList.add("inline-flex");

      const existing = feedbackTimeouts.get(button);
      if (existing) window.clearTimeout(existing);

      feedbackTimeouts.set(
        button,
        window.setTimeout(() => {
          label?.classList.remove("hidden");
          icon?.classList.remove("hidden");
          feedback?.classList.add("hidden");
          feedback?.classList.remove("inline-flex");
          feedbackTimeouts.delete(button);
        }, 2000),
      );
    });
  });
</script>