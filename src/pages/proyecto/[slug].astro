---
import BaseLayout from "../../layouts/BaseLayout.astro";
import Navbar from "../../components/Navbar.astro";
import Footer from "../../components/Footer.astro";
import Lightbox from "../../components/Lightbox.astro";
import { Image } from "astro:assets";
import { CONTENT } from "../../utils/content";
import type { ImageMetadata } from "astro";

const imageModules = import.meta.glob<ImageMetadata>(
  "../../assets/images/*/*.webp",
  { eager: true, import: "default" },
);

const projectImages: Record<string, { num: number; image: ImageMetadata }[]> =
  {};

for (const [path, image] of Object.entries(imageModules)) {
  const match = path.match(/([^/]+)\/(\d+)\.webp$/);
  if (!match) continue;
  const [, folder, numStr] = match;
  (projectImages[folder] ??= []).push({ num: Number(numStr), image });
}

const getProjectImages = (folder: string): ImageMetadata[] =>
  (projectImages[folder] ?? [])
    .sort((a, b) => a.num - b.num)
    .map(({ image }) => image);

export function getStaticPaths() {
  return CONTENT.design.projects.map((project) => ({
    params: { slug: project.slug },
    props: { project },
  }));
}

const { project } = Astro.props;
const images = getProjectImages(project.folder);
const lightboxImages = images.map((img) => img.src);
---

<BaseLayout title={`Magalí Mc Grath | ${project.title}`}>
  <Navbar active="diseno-interiores" />

  <main class="pt-8 pb-4">
    <section class="max-w-7xl mx-auto px-6 md:px-16 mb-8">
      <a
        href="/#interior-design"
        class="inline-flex items-center gap-1 font-body text-xs text-primary uppercase tracking-widest no-underline mb-8 hover:gap-2 transition-all"
      >
        <span class="material-symbols-outlined text-sm">arrow_back</span>
        Volver a Proyectos
      </a>

      <div class="flex items-baseline gap-4 mb-4">
        <span
          class="font-body text-lg font-bold text-light uppercase tracking-widest"
        >
          {project.number}
        </span>
        <h1
          class="font-headline text-headline-xl-mobile md:text-headline-xl text-dark m-0"
        >
          {project.title}
        </h1>
      </div>
    </section>
  </main>

  <section class="max-w-7xl mx-auto px-6 md:px-16 mb-16">
    <div class="mb-12">
      <h2 class="font-headline text-headline-md text-dark m-0 mb-4">
        Sobre el proyecto
      </h2>
      {
        (Array.isArray(project.details)
          ? project.details
          : [project.details]
        ).map((paragraph) => (
          <p class="font-body text-base text-dark leading-relaxed my-2">
            {paragraph}
          </p>
        ))
      }
    </div>
  </section>

  <section class="max-w-7xl mx-auto px-6 md:px-16">
    <div
      class="flex flex-col md:flex-row md:flex-wrap gap-4"
      data-lightbox-group
      data-lightbox-id="project-lightbox"
    >
      {
        images.map((img, index) => (
          <div
            class={`overflow-hidden rounded-2xl cursor-pointer h-64 ${index === 0 ? "md:w-[calc(66.667%-0.5rem)]" : "md:w-[calc(33.333%-0.667rem)]"}`}
            data-lightbox-src={lightboxImages[index]}
          >
            <Image
              class="w-full h-full object-cover transition-transform duration-700 hover:scale-105"
              src={img}
              alt={`${project.title} - imagen ${index + 1}`}
            />
          </div>
        ))
      }
    </div>
  </section>
</BaseLayout>

<Lightbox id="project-lightbox" />

<Footer />
